model Book {
    id       Int    @id @default(autoincrement())
    publicId String @unique @default(dbgenerated("generate_public_id()"))

    authors  Author[]
    subjects Subject[]
    editions BookEdition[]
}

model BookEdition {
    id       Int    @id @default(autoincrement())
    publicId String @unique @default(dbgenerated("generate_public_id()"))

    bookId Int
    book   Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

    title     String
    subtitle  String?
    pageCount Int?

    isbn10 String? @unique
    isbn13 String? @unique

    languageId Int?
    language   Language? @relation(fields: [languageId], references: [id])

    authors    Author[]
    publishers Publisher[]

    publishDate   PublishDate?
    image         Image[]
    ratings       UserBookRating[]
    readingStates UserBookReadingState[]
    collections   BookCollection[]

    copies BookCopy[]
}

model Image {
    id Int @id @default(autoincrement())

    width     Int
    height    Int
    createdAt DateTime @default(now())

    editionId Int
    edition   BookEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
}

model PublishDate {
    id Int @id @default(autoincrement())

    year  Int
    month Int?
    day   Int?

    editionId Int         @unique
    edition   BookEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
}

model Language {
    id    Int    @id @default(autoincrement())
    value String @unique

    editions BookEdition[]
}

model Author {
    id   Int    @id @default(autoincrement())
    name String @unique

    books    Book[]
    editions BookEdition[]
}

model Publisher {
    id   Int    @id @default(autoincrement())
    name String @unique

    editions BookEdition[]
}

model Subject {
    id    Int    @id @default(autoincrement())
    value String @unique

    books Book[]
}

model BookCollection {
    id Int @id @default(autoincrement())

    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    ownerId  Int
    owner    User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    editions BookEdition[]
}
